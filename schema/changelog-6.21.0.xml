<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd"
  logicalFilePath="changelog-6.21.0">

  <!-- Freematics: identity of every stored record (device, boot number, ms
       since that boot). A re-sent record with a known identity is not stored
       again; the device gets an ACK only after its records are stored. -->
  <changeSet author="author" id="changelog-6.21.0">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="tc_freematics_records"/>
      </not>
    </preConditions>

    <createTable tableName="tc_freematics_records">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="deviceid" type="INT">
        <constraints nullable="false" />
      </column>
      <column name="bootid" type="BIGINT">
        <constraints nullable="false" />
      </column>
      <column name="ts" type="BIGINT">
        <constraints nullable="false" />
      </column>
    </createTable>

    <addUniqueConstraint tableName="tc_freematics_records"
      columnNames="deviceid, bootid, ts" constraintName="uk_freematics_records" />

  </changeSet>

</databaseChangeLog>
