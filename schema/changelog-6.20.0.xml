<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd"
  logicalFilePath="changelog-6.20.0">

  <!-- Trip logbook: a manually chosen start/end address for one trip,
       overriding the one derived from its start/end position (e.g. a trip
       whose first GPS fix came ~1 km after leaving a business address). -->
  <changeSet author="author" id="changelog-6.20.0">
    <preConditions onFail="MARK_RAN">
      <not>
        <columnExists tableName="tc_trip_purposes" columnName="startaddress"/>
      </not>
    </preConditions>

    <addColumn tableName="tc_trip_purposes">
      <column name="startaddress" type="VARCHAR(512)" />
      <column name="endaddress" type="VARCHAR(512)" />
    </addColumn>

  </changeSet>

</databaseChangeLog>
