<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd"
  logicalFilePath="changelog-6.22.0">

  <!-- Vehicle registry for the travel order (cestovný príkaz): the car's
       data from its technical certificate, and which box was in which car
       when (a trip belongs to the vehicle assigned at its start). -->
  <changeSet author="author" id="changelog-6.22.0">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="tc_vehicles"/>
      </not>
    </preConditions>

    <createTable tableName="tc_vehicles">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="plate" type="VARCHAR(32)">
        <constraints nullable="false" />
      </column>
      <column name="name" type="VARCHAR(128)" />
      <column name="vin" type="VARCHAR(32)" />
      <column name="category" type="VARCHAR(16)" />
      <column name="ownership" type="VARCHAR(16)" defaultValue="company">
        <constraints nullable="false" />
      </column>
      <column name="holder" type="VARCHAR(128)" />
      <column name="fuel" type="VARCHAR(32)" />
      <column name="tankcapacity" type="DOUBLE" defaultValueNumeric="0">
        <constraints nullable="false" />
      </column>
      <column name="consumptiontype" type="VARCHAR(16)" />
      <column name="consumptioncombined" type="DOUBLE" defaultValueNumeric="0">
        <constraints nullable="false" />
      </column>
      <column name="consumptionurban" type="DOUBLE" defaultValueNumeric="0">
        <constraints nullable="false" />
      </column>
      <column name="consumptionextraurban" type="DOUBLE" defaultValueNumeric="0">
        <constraints nullable="false" />
      </column>
      <column name="consumptionsource" type="VARCHAR(256)" />
      <column name="note" type="VARCHAR(512)" />
    </createTable>

    <createTable tableName="tc_vehicle_assignments">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="vehicleid" type="BIGINT">
        <constraints nullable="false" />
      </column>
      <column name="deviceid" type="INT">
        <constraints nullable="false" />
      </column>
      <column name="fromtime" type="TIMESTAMP">
        <constraints nullable="false" />
      </column>
      <column name="totime" type="TIMESTAMP" />
    </createTable>

  </changeSet>

  <!-- Travel order: allowance rates from slov-lex, fuel receipts, issued
       orders (with their whole computation frozen as JSON). -->
  <changeSet author="author" id="changelog-6.22.0-travelorder">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="tc_travel_orders"/>
      </not>
    </preConditions>

    <createTable tableName="tc_allowance_rates">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="kind" type="VARCHAR(16)">
        <constraints nullable="false" />
      </column>
      <column name="country" type="VARCHAR(2)" />
      <column name="countryname" type="VARCHAR(128)" />
      <column name="currency" type="VARCHAR(3)">
        <constraints nullable="false" />
      </column>
      <column name="amount1" type="DOUBLE" defaultValueNumeric="0">
        <constraints nullable="false" />
      </column>
      <column name="amount2" type="DOUBLE" defaultValueNumeric="0">
        <constraints nullable="false" />
      </column>
      <column name="amount3" type="DOUBLE" defaultValueNumeric="0">
        <constraints nullable="false" />
      </column>
      <column name="validfrom" type="TIMESTAMP">
        <constraints nullable="false" />
      </column>
      <column name="source" type="VARCHAR(64)" />
    </createTable>

    <createTable tableName="tc_fuel_receipts">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="vehicleid" type="BIGINT">
        <constraints nullable="false" />
      </column>
      <column name="time" type="TIMESTAMP">
        <constraints nullable="false" />
      </column>
      <column name="litres" type="DOUBLE" defaultValueNumeric="0">
        <constraints nullable="false" />
      </column>
      <column name="amount" type="DOUBLE" defaultValueNumeric="0">
        <constraints nullable="false" />
      </column>
      <column name="currency" type="VARCHAR(3)">
        <constraints nullable="false" />
      </column>
      <column name="station" type="VARCHAR(128)" />
      <column name="companycard" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false" />
      </column>
      <column name="source" type="VARCHAR(16)" />
      <column name="note" type="VARCHAR(512)" />
    </createTable>

    <createTable tableName="tc_travel_orders">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" />
      </column>
      <column name="number" type="VARCHAR(32)">
        <constraints nullable="false" />
      </column>
      <column name="year" type="INT">
        <constraints nullable="false" />
      </column>
      <column name="sequence" type="INT">
        <constraints nullable="false" />
      </column>
      <column name="driverid" type="BIGINT">
        <constraints nullable="false" />
      </column>
      <column name="deviceid" type="INT">
        <constraints nullable="false" />
      </column>
      <column name="fromtime" type="TIMESTAMP">
        <constraints nullable="false" />
      </column>
      <column name="totime" type="TIMESTAMP">
        <constraints nullable="false" />
      </column>
      <column name="created" type="TIMESTAMP">
        <constraints nullable="false" />
      </column>
      <column name="total" type="DOUBLE" defaultValueNumeric="0">
        <constraints nullable="false" />
      </column>
      <column name="result" type="TEXT" />
    </createTable>

    <addUniqueConstraint tableName="tc_travel_orders"
      columnNames="driverid, year, sequence" constraintName="uk_travel_orders_number" />

  </changeSet>

</databaseChangeLog>
