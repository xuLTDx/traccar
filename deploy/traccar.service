[Unit]
Description=traccar
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=traccar
Group=traccar
WorkingDirectory=/home/traccar
ExecStart=/home/traccar/jre/bin/java -jar tracker-server.jar conf/traccar.xml
SyslogIdentifier=traccar
SuccessExitStatus=143
WatchdogSec=600
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
